[Unit]
Description=SAP GrokBot Web and browser workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sap-grokbot
Group=sap-grokbot
WorkingDirectory=/opt/sap-grokbot
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sap-grokbot/.browsers
Environment=HOME=/var/lib/sap-grokbot
Environment=XDG_RUNTIME_DIR=/run/sap-grokbot
EnvironmentFile=/etc/sap-grokbot/web.env
ExecStart=/usr/bin/node sap-grokbot/web/server.mjs
Restart=on-failure
StateDirectory=sap-grokbot
StateDirectoryMode=0700
RuntimeDirectory=sap-grokbot
RuntimeDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TasksMax=1024

[Install]
WantedBy=multi-user.target
