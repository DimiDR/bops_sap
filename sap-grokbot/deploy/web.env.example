# Default: Entra / OAuth2-Proxy cloud mode (omit SAP_AUTH_MODE or set entra).
SAP_AUTH_MODE=entra
SAP_APP_ORIGIN=https://grokbot.example.com
SAP_PROXY_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
SAP_AUDIT_FILE=/var/lib/sap-grokbot/audit.jsonl
SAP_ENTRA_GROUP=ENTRA_GROUP_OBJECT_ID
# Omit these settings to start the authenticated fixture first.
# SAP_BROWSER_TARGET='{"url":"https://sap-connector.example.ts.net/sap/bc/ui2/flp","label":"Testauftrag","loginOrigins":["https://login.microsoftonline.com"],"identitySelector":"[data-example-sap-user]","recordSelector":"[data-example-order-id]","recordValue":"4500000173","noteSelector":"[data-example-saved-note]","writes":false}'
# SAP_USER_MAP='{"entra-subject-example":"SAP_TEST_USER"}'
# SAP_MODEL_PROFILES='[{"id":"anbieter-eins","url":"https://model.example.com/v1/chat/completions","model":"configured-model","keyEnv":"MODEL_ONE_KEY"}]'
# MODEL_ONE_KEY=REPLACE_WITH_SECRET

# Local single-machine test against a real SAP URL without Entra (opt-in only).
# Binds to 127.0.0.1, logs a startup warning, keeps approval/Origin/audit checks.
# SAP_AUTH_MODE=none
# SAP_APP_ORIGIN=http://127.0.0.1:3211
# SAP_AUDIT_FILE=/var/lib/sap-grokbot/audit-local.jsonl
# SAP_LOCAL_ACTOR=local-test
# SAP_USER_MAP='{"local-test":"SAP_TEST_USER"}'
# SAP_BROWSER_TARGET='{"url":"https://sap-connector.example.ts.net/sap/bc/ui2/flp","label":"Testauftrag","loginOrigins":["https://login.microsoftonline.com"],"identitySelector":"[data-example-sap-user]","recordSelector":"[data-example-order-id]","recordValue":"4500000173","noteSelector":"[data-example-saved-note]","writes":false}'
